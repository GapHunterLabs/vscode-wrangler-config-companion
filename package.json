{
  "name": "wrangler-config-companion",
  "displayName": "Wrangler Config Companion",
  "description": "Validates wrangler.toml -- required fields (name/main/compatibility_date), and missing binding/id in kv_namespaces/r2_buckets/d1_databases entries. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "cloudflare",    "workers",    "wrangler",    "toml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-wrangler-config-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-wrangler-config-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
